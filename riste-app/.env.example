# ---- Database ----
DATABASE_URL="postgresql://riste:riste@localhost:5432/riste?schema=public"

# ---- Redis (BullMQ queue) ----
REDIS_URL="redis://localhost:6379"

# ---- AI provider: ollama | gemini | groq ----
AI_PROVIDER="ollama"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
GEMINI_API_KEY=""
GROQ_API_KEY=""

# ---- Email channel (Gmail) ----
# Use a Gmail App Password, NOT your real password. https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
EMAIL_FROM_NAME="Sangram"

# ---- WhatsApp (Meta Cloud API) ----
# From your Meta WhatsApp Business app / BSP. Proactive greetings need an
# approved template; replies within 24h are free-form. Costs per template msg.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="pick-any-string-matching-your-webhook-setup"
WHATSAPP_GREETING_TEMPLATE="" # approved template name for proactive greetings

# ---- Festivals (Calendarific) ----
# Free key from https://calendarific.com . Pull once a year; curate the rest by hand.
CALENDARIFIC_API_KEY=""
FESTIVAL_COUNTRY="IN"

# ---- SMS channel (android-sms-gateway on your phone) ----
# Local mode: the app on your phone, reachable from the VPS/LAN.
SMS_GATEWAY_URL="http://192.168.1.50:8080"
SMS_GATEWAY_USERNAME="sms"
SMS_GATEWAY_PASSWORD="your-gateway-password"

# ---- Notifications: Telegram (approve/reject from chat) ----
# 1) Create a bot with @BotFather -> get the token. 2) Message your bot, then
# visit https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---- App ----
APP_URL="http://localhost:3000"
# Shared secret for inbound webhooks (SMS gateway / email poller post here)
WEBHOOK_SECRET="change-me-to-a-long-random-string"
