generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Autonomy {
  SUPERVISED // AI drafts, you approve everything
  AUTO_GREETINGS // greetings auto, replies need approval
  FULL_AUTO // everything sent automatically (with guardrails)
}

enum ChannelType {
  EMAIL
  SMS
  WHATSAPP
}

enum ConsentStatus {
  UNKNOWN // never confirmed — we do not send (default)
  PENDING // asked, awaiting confirmation
  GRANTED // recipient agreed to receive messages
  REVOKED // recipient opted out (STOP / unsubscribe)
}

enum Direction {
  IN
  OUT
}

enum MessageStatus {
  QUEUED
  AWAITING_APPROVAL // default: drafted, waiting for your explicit approval
  SENT
  DELIVERED
  READ
  FAILED
  HELD // escalated: AI flagged it needs a human
  REJECTED // you discarded the draft
}

model Contact {
  id           String           @id @default(cuid())
  name         String
  relationship String // mother, friend, partner, colleague...
  timezone     String           @default("Asia/Kolkata")
  language     String           @default("en")
  autonomy     Autonomy         @default(SUPERVISED)
  morningTime  String? // "08:00" local, null = no morning greeting
  eveningTime  String? // "21:00" local, null = no evening greeting
  festivals    String[] // tags this contact celebrates: ["hindu","diwali","birthday:1990-05-12"]
  active       Boolean          @default(true)
  channels     ContactChannel[]
  toneProfile  ToneProfile?
  messages     Message[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ContactChannel {
  id        String      @id @default(cuid())
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  type      ChannelType
  value     String // email address / phone number
  isPrimary Boolean     @default(false)
  // --- Phase 2 consent / anti-spam ---
  consentStatus ConsentStatus @default(UNKNOWN) // we never send unless GRANTED
  consentSource String? // "verbal" | "double_opt_in" | "imported" | "reply_confirmed"
  consentAt     DateTime?
  optedOutAt    DateTime? // set on STOP / unsubscribe — a hard, permanent block

  @@unique([contactId, type])
}

model ToneProfile {
  id             String   @id @default(cuid())
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId      String   @unique
  sampleMessages String[] // YOUR real past texts to this person (seed the voice)
  styleNotes     String   @default("") // "short, lots of emojis, calls her Aai, never formal"
  languageMix    String   @default("") // "Hindi-English mix"
  doNotSay       String[] // topics/phrases to avoid
}

model Message {
  id           String        @id @default(cuid())
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId    String
  channel      ChannelType
  direction    Direction
  body         String
  status       MessageStatus @default(QUEUED)
  aiGenerated  Boolean       @default(false)
  confidence   Float?
  externalId   String? // provider message id, for delivery webhooks
  // --- Phase 1 validation instrumentation ---
  originalBody    String? // the AI's first draft, snapshotted so edit distance survives in-place edits
  editDistance    Int? // chars changed between AI draft and what was actually sent (authenticity signal)
  heldReason      String? // why this was escalated/held
  replyReceivedAt DateTime? // when the recipient replied to this outbound (reply-rate signal)
  replySentiment  String? // optional later: positive/neutral/negative classification of the reply
  createdAt    DateTime      @default(now())
  sentAt       DateTime?

  @@index([contactId, createdAt])
  @@index([status])
}

// Append-only product-analytics stream for the Phase 1 validation pilot.
// One row per meaningful action so we can measure whether the idea works:
// approval rate, verbatim-send rate, regen rate, reply rate, time saved.
model Event {
  id        String       @id @default(cuid())
  type      String // draft_created | approved | approved_edited | rejected | regenerated | sent | auto_sent | failed | held | reply_received
  messageId String?
  contactId String?
  channel   ChannelType?
  meta      Json? // { editDistance, confidence, slot, festival, latencyMs, ... }
  createdAt DateTime     @default(now())

  @@index([type, createdAt])
  @@index([contactId])
}

// Immutable record of everything actually sent and received. Kept separate from
// the mutable Message table so consent/abuse investigations have a clean trail.
model AuditLog {
  id          String      @id @default(cuid())
  contactId   String
  channel     ChannelType
  direction   Direction
  body        String
  externalId  String?
  aiGenerated Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([contactId, createdAt])
}

model Festival {
  id     String   @id @default(cuid())
  name   String
  date   String // YYYY-MM-DD (compared against the contact's local date)
  tags   String[] // lowercased: "national holiday", "hindu", "observance"...
  region String   @default("IN")
  source String   @default("calendarific") // or "manual"

  @@unique([date, name])
  @@index([date])
}

model Setting {
  id              Int      @id @default(1)
  killSwitch      Boolean  @default(false)
  quietHoursStart String   @default("22:00")
  quietHoursEnd   String   @default("07:00")
  defaultAutonomy Autonomy @default(SUPERVISED)
  aiProvider      String   @default("ollama")
  // --- Phase 2 consent / anti-spam / disclosure ---
  requireConsent      Boolean @default(true) // block sends to non-GRANTED channels
  maxPerContactPerDay Int     @default(2) // rolling-24h send cap per contact+channel
  aiDisclosure        Boolean @default(false) // append a "sent with help from AI" line to greetings
  disclosureText      String  @default("")
  updatedAt       DateTime @updatedAt
}
